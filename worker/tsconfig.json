{
  // The Worker is checked separately from the site: it runs on workerd, not in
  // a browser and not in node, so it needs Cloudflare's globals rather than the
  // site's DOM lib. The root tsconfig excludes worker/ for the same reason
  // packages/ is excluded there.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // workerd's globals, plus the `cloudflare:test` module the tests under
    // worker/test/ import - they live inside this project, so its types have
    // to be declared here or `npm run typecheck:worker` fails on them.
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The migrations journal is imported so /api/health can say which
    // migration this build expects. Wrangler bundles JSON on its own.
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["."]
}
