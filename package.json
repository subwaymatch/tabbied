{
  "name": "tabbied-nextjs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:packages && npm run llms && npm run build:images && npm run check:thumbnails && npm run check:previews",
    "dev": "NEXT_PUBLIC_API_BASE=http://localhost:8787 next dev",
    "dev:api": "wrangler dev --port 8787",
    "prebuild": "npm run build:packages && npm run llms && npm run build:images && npm run check:thumbnails && npm run check:previews",
    "build": "next build && npm run editable && npm run templates -- --out-dir public/downloads && npm run preview:runtime && next build",
    "build:packages": "npm run build --workspace tabbied && npm run build --workspace tabbied-templates && npm run build --workspace tabbied-mcp",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "preview": "wrangler dev",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply tabbied --local",
    "db:migrate:remote": "wrangler d1 migrations apply tabbied --remote",
    "admin:grant": "node scripts/admin-grant.mjs",
    "stub:ai": "node worker/test/stub-upstream.mjs",
    "test:worker": "vitest run --config worker/vitest.config.mts",
    "llms": "node scripts/generate-llms.mjs",
    "editable": "node scripts/generate-editable.mjs",
    "annotate:templates": "node scripts/annotate-templates.mjs",
    "templates": "node scripts/package-templates.mjs",
    "preview:runtime": "node scripts/build-preview-runtime.mjs",
    "build:images": "node scripts/build-image-manifest.mjs",
    "check:thumbnails": "node scripts/check-gallery-thumbnails.mjs",
    "previews": "node scripts/generate-previews.mjs",
    "check:previews": "node scripts/check-previews.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "start": "serve out -l 3000 --no-clipboard",
    "test:e2e": "playwright test",
    "images:extract": "node scripts/images/extract-prompts.mjs",
    "images:build": "node scripts/images/build-batch.mjs",
    "images:submit": "node scripts/images/submit-batch.mjs",
    "images:import": "node scripts/images/import-batch.mjs",
    "images:index": "node scripts/images/index-images.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-auth": "^1.7.2",
    "css-doodle": "^0.51.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.3",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tabbied": "*",
    "tabbied-mcp": "*",
    "tabbied-templates": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "fflate": "^0.8.3",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.42.0"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
