# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and workspace packages)
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth

# next.js
/.next/
/out/

# packaged template downloads (~106 MB of zips + the folders they were made
# from). Written by `npm run templates`, which the build runs between its two
# `next build` passes so the second one exports them.
/public/downloads/
next-env.d.ts
*.tsbuildinfo

# production
/build

# tabbied package build output (dist + codegen artifacts)
/packages/tabbied/dist/
/packages/tabbied/src/patterns.generated.ts
/packages/tabbied/catalog.json

# tabbied-mcp build output
/packages/tabbied-mcp/dist/

# tabbied-templates build output
/packages/tabbied-templates/dist/

# agent-facing docs generated from the catalog by scripts/generate-llms.mjs
/public/llms.txt
/public/llms-full.txt
/public/catalog.json

# editable-section specs, derived from the export by scripts/generate-editable.mjs
# (runs inside `npm run build`, between the two `next build` passes)
/public/editable/
/public/editable-catalog.json

# Studio's same-origin pattern runtime, bundled from the packaged templates
# by scripts/build-preview-runtime.mjs during the build.
/public/studio/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (the image pipeline reads .env / .env.local for KIE_API_KEY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# cloudflare (wrangler's local state, dev cache, and generated env types)
.wrangler/
worker-configuration.d.ts

# generated image-batch working files (manifest, JSONL, batch state)
/scripts/images/.batch/

# GPT Image 2 output from scripts/generate-images.mjs - candidates only.
# Only the promoted public/images/sites/*.webp is committed.
generated-images/

# Sandbox-only Playwright override (chromium build mismatch); never committed.
playwright.local.config.ts

# The package's agent-facing reference, written by its build (generate-llms.mjs)
/packages/tabbied/llms.txt

# Worker secrets for local dev (wrangler reads this; never commit it).
.dev.vars
